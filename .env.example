# ─────────────────────────────────────────────────────────────
# Second Self environment
# Copy to .env and fill in the values you use.
# ─────────────────────────────────────────────────────────────

# ── App ──────────────────────────────────────────────────────
NEXT_PUBLIC_BACKEND_URL=http://localhost:8000
ALLOWED_ORIGINS=http://localhost:3000
DEMO_MODE=false
HOST=0.0.0.0
PORT=8000

# ── AI ───────────────────────────────────────────────────────
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-sonnet-4-20250514

# ── Gnani voice agent ────────────────────────────────────────
# The only speech provider in this project.
#   Speech-to-text : Gnani Prisma v2.5
#   Text-to-speech : Gnani Timbre v2.5
GNANI_API_KEY=
GNANI_STT_MODEL=prisma-v2.5
# Prisma accepts one language per request: en-IN, hi-IN, ta-IN, ...
GNANI_STT_LANGUAGE=en-IN
GNANI_TTS_MODEL=timbre-v2.5
# Voice from the Timbre v2.5 catalog
GNANI_TTS_VOICE=Kaveri
# auto, en-IN, hi-IN, hi-en, ta-IN, ...
GNANI_TTS_LANGUAGE=auto

# ── Web search ───────────────────────────────────────────────
TAVILY_API_KEY=

# ── Auth0 (web app + macOS PKCE flow) ────────────────────────
AUTH0_DOMAIN=
AUTH0_CLIENT_ID=
AUTH0_CLIENT_SECRET=
AUTH0_SECRET=

# ── Firebase (auth + Firestore) ──────────────────────────────
FIREBASE_API_KEY=
FIREBASE_AUTH_DOMAIN=
FIREBASE_PROJECT_ID=
FIREBASE_SERVICE_ACCOUNT_PATH=
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=

# ── Google (Gmail + Calendar) ────────────────────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8080

# ── Identity pipeline (optional overrides) ───────────────────
USER_NAME=
USER_EMAIL=
